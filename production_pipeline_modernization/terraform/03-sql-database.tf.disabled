# ============================================================================
# SQL Database Resources for Hash Validation Logging
# ============================================================================
# This assumes you have an existing SQL Server and creates the logging table

# ============================================================================
# Data source for existing SQL Server
# ============================================================================

data "azurerm_mssql_server" "existing" {
  name                = var.sql_server_name
  resource_group_name = var.resource_group_name
}

# ============================================================================
# SQL Database for logging (if it doesn't exist)
# ============================================================================
# Uncomment if you need to create a new database

# resource "azurerm_mssql_database" "hash_validation_db" {
#   name      = "db-hash-validation-${var.environment}"
#   server_id = data.azurerm_mssql_server.existing.id
#
#   sku_name = "Basic"  # Cheapest tier for logging
#
#   max_size_gb = 2  # 2GB is enough for logging
#
#   tags = {
#     environment = var.environment
#     project     = "hash-validation"
#     purpose     = "logging"
#   }
# }

# ============================================================================
# SQL Script to Create Logging Table
# ============================================================================
# This will be executed after database is ready

# Note: Terraform doesn't natively execute SQL scripts
# You'll need to run this manually or use a provisioner
# See the deployment guide for instructions

locals {
  create_table_sql = <<-SQL
    -- Hash Validation Logging Table
    IF NOT EXISTS (SELECT * FROM sys.tables WHERE name = 'hash_validation_log')
    BEGIN
        CREATE TABLE [dbo].[hash_validation_log] (
            validation_id UNIQUEIDENTIFIER PRIMARY KEY DEFAULT NEWID(),
            file_name NVARCHAR(255) NOT NULL,
            validation_result NVARCHAR(20) NOT NULL, -- 'PASS', 'FAIL', 'ERROR'
            ok_count INT DEFAULT 0,
            fail_count INT DEFAULT 0,
            missing_count INT DEFAULT 0,
            extra_count INT DEFAULT 0,
            validation_time DATETIME2 NOT NULL DEFAULT GETDATE(),
            details NVARCHAR(MAX),
            execution_duration_seconds INT,
            hash_algorithm NVARCHAR(20) DEFAULT 'SHA512',
            created_date DATETIME2 NOT NULL DEFAULT GETDATE()
        );

        -- Indexes for query performance
        CREATE INDEX IX_validation_time ON [dbo].[hash_validation_log](validation_time DESC);
        CREATE INDEX IX_validation_result ON [dbo].[hash_validation_log](validation_result);
        CREATE INDEX IX_file_name ON [dbo].[hash_validation_log](file_name);
    END

    -- Stored Procedure for Logging
    IF EXISTS (SELECT * FROM sys.procedures WHERE name = 'sp_log_hash_validation')
        DROP PROCEDURE [dbo].[sp_log_hash_validation];
    GO

    CREATE PROCEDURE [dbo].[sp_log_hash_validation]
        @file_name NVARCHAR(255),
        @validation_result NVARCHAR(20),
        @ok_count INT = 0,
        @fail_count INT = 0,
        @missing_count INT = 0,
        @extra_count INT = 0,
        @details NVARCHAR(MAX) = NULL,
        @execution_duration_seconds INT = NULL
    AS
    BEGIN
        SET NOCOUNT ON;

        DECLARE @validation_id UNIQUEIDENTIFIER = NEWID();

        INSERT INTO [dbo].[hash_validation_log] (
            validation_id,
            file_name,
            validation_result,
            ok_count,
            fail_count,
            missing_count,
            extra_count,
            details,
            execution_duration_seconds,
            validation_time
        )
        VALUES (
            @validation_id,
            @file_name,
            @validation_result,
            @ok_count,
            @fail_count,
            @missing_count,
            @extra_count,
            @details,
            @execution_duration_seconds,
            GETDATE()
        );

        -- Return the validation_id for reference
        SELECT @validation_id AS validation_id, @@ROWCOUNT AS rows_inserted;
    END;
    GO
  SQL
}

# Save SQL script to file for manual execution
resource "local_file" "create_table_script" {
  content  = local.create_table_sql
  filename = "${path.module}/scripts/create_logging_table.sql"
}

# ============================================================================
# Outputs
# ============================================================================

output "sql_server_name" {
  description = "Name of the SQL Server"
  value       = data.azurerm_mssql_server.existing.name
}

output "sql_script_location" {
  description = "Location of SQL table creation script"
  value       = local_file.create_table_script.filename
}
