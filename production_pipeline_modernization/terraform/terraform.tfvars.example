# ============================================================================
# Terraform Variables - Example Configuration
# ============================================================================
# Copy this file to terraform.tfvars and fill in your actual values
# IMPORTANT: Never commit terraform.tfvars to Git (contains secrets)

# ============================================================================
# Basic Configuration
# ============================================================================

environment         = "dev"
location            = "Canada Central"
resource_group_name = "rg-hash-validation-dev"

# ============================================================================
# Storage Account
# ============================================================================

storage_account_name = "stdldevshared77b5h3"  # Your existing storage account

# ============================================================================
# SQL Server
# ============================================================================

sql_server_name = "sql-server-name-here"  # Your SQL Server name

sql_connection_string = "Server=tcp:your-server.database.windows.net,1433;Initial Catalog=your-database;Persist Security Info=False;User ID=your-username;Password=your-password;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"

# ============================================================================
# Alerts
# ============================================================================

alert_email_recipients = "manager@company.com,team@company.com"

# Optional: SendGrid for email alerts
# sendgrid_api_key = "SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ============================================================================
# Common Tags
# ============================================================================

common_tags = {
  project     = "hash-validation"
  managed_by  = "terraform"
  cost_center = "data_platform"
  environment = "dev"
  department  = "IT"
}
